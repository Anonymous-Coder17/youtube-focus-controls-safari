{
  "manifest_version": 3,
  "name": "YouTube Focus Controls",
  "version": "1.0.0",
  "description": "Choose which YouTube distractions to hide in Safari.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://www.youtube-nocookie.com/*"
  ],
  "action": {
    "default_title": "YouTube Focus Controls",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.youtube-nocookie.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "youtube-focus-controls@personal.local" }
  }
}
